{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable"],
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/paths.ts",
    "src/shared/**/*.ts",
    "src/library/**/*.ts",
    "src/draft/**/*.ts",
    "src/optimize/**/*.ts",
    "src/companion/**/*.ts",
    "src/web/**/*.ts"
  ]
}
